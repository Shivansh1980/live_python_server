APP_ENV=development
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=use-a-strong-password
SESSION_SECRET=generate-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example

# Discord incoming webhook (optional)
DISCORD_WEBHOOK_URL=

# Gmail SMTP with a Google App Password (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_APP_PASSWORD=
NOTIFICATION_EMAIL_TO=where-to-receive@example.com
